PORT=8080
NODE_ENV=production

# PostgreSQL
DATABASE_URL=postgresql://tracker:tracker@postgres:5432/tracker

# Browser Basic Auth for /admin and /api/admin/*
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Coolify/Traefik proxy and PostgreSQL safety limits
TRUST_PROXY_HOPS=1
PGPOOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=3000
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=10000
